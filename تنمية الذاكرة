  {title:"ذاكرة نشيطة",description:"إكمال خمسة تحديات من ألعاب الذاكرة",symbol:"✦",earned:stats.games>=5},
  {title:"محبة المعرفة",description:"إكمال أول اختبار للمجلة",symbol:"✓",earned:stats.quizzes>=1},
  {title:"متفوقة",description:"الحصول على الدرجة الكاملة في الاختبار",symbol:"◆",earned:best===5},
  {title:"صاحبة الأفكار",description:"حفظ أول ملاحظة في مفكرة العقل",symbol:"✎",earned:entries.length>=1},
  {title:"كاتبة المفكرة",description:"حفظ خمس ملاحظات في المفكرة",symbol:"▤",earned:entries.length>=5},
  {title:"رحلة مستمرة",description:"إكمال عشرة أنشطة متنوعة",symbol:"♧",earned:total>=10}
 ];

 document.getElementById("badgesGrid").innerHTML=badges.map(function(badge){
