 if(!assistantAnswers[topic])return;
 response.innerHTML="<strong>إجابة المستشار الذكي:</strong><br>"+assistantAnswers[topic];
}

function sendAssistantQuestion(){
 const input=document.getElementById("assistantInput");
 const question=input.value.trim();
 const response=document.getElementById("assistantResponse");
 if(!question){
  response.innerHTML="<strong>اكتبي سؤالك أولًا.</strong><br>يمكنك السؤال عن الذاكرة أو النسيان أو الحفظ أو التركيز أو المراجعة أو النوم.";
  return;
 }
 const topic=detectAssistantTopic(question);
 const answer=topic?assistantAnswers[topic]:"لم أتعرف على موضوع السؤال بشكل كافٍ. جربي صياغته بطريقة أخرى، ويمكنك السؤال عن الذاكرة أو النسيان أو الحفظ أو التركيز أو المراجعة أو النوم.";
 response.innerHTML="<strong>سؤالك:</strong> "+escapeHTML(question)+"<br><br><strong>تحليل السؤال والإجابة:</strong><br>"+answer;
 input.value="";
}

