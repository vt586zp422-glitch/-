<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>تنمية الذاكرة | مجلة العقل</title>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">

<style>
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:#f2f0eb;color:#343d3a;font-family:Tajawal,sans-serif}

/* الهيدر */
header{
 background:#fff;color:#39443f;display:flex;align-items:center;
 justify-content:space-between;padding:14px 5%;position:sticky;
 top:0;z-index:10;flex-wrap:wrap;gap:15px;
 box-shadow:0 4px 20px #26352c12;border-bottom:1px solid #e8e6df
}
.header-brand{display:flex;align-items:center;gap:13px}
.college-logo{width:155px;height:58px;object-fit:contain;display:block;background:white;border-radius:8px;padding:4px}
.logo{font-size:23px;font-weight:800;color:#536d60}
.logo span{display:block;font-size:12px;color:#9a9587;font-weight:500}
nav{display:flex;gap:8px;flex-wrap:wrap}
nav a{
 color:#59665d;text-decoration:none;font-weight:700;font-size:13px;
 cursor:pointer;padding:9px 13px;border:1px solid #e8e6df;
 border-radius:8px;transition:.25s
}
nav a:hover{background:#536d60;color:white;border-color:#536d60}

/* الواجهة الرئيسية */
.hero{
 margin:28px auto;width:92%;height:530px;position:relative;
 overflow:hidden;border-radius:24px;background:#263d34;
 box-shadow:0 18px 45px #26352c20
}
.hero img{width:100%;height:100%;object-fit:cover;display:block}
.hero:after{
 content:"";position:absolute;inset:0;
 background:linear-gradient(90deg,#172c25e8 0%,#172c259c 48%,#172c2510 100%)
}
.hero-content{position:absolute;z-index:2;top:50%;right:8%;transform:translateY(-50%);max-width:540px;color:white}
.eyebrow{
 display:inline-block;color:#e6d2a9;font-weight:800;letter-spacing:1px;
 font-size:14px;padding:8px 15px;border:1px solid #e6d2a966;border-radius:30px
}
.hero h1{font-size:clamp(38px,5.5vw,68px);line-height:1.25;margin:20px 0}
.hero p{font-size:18px;line-height:2;color:#f0eee7;max-width:470px}
button{
 border:0;border-radius:9px;padding:13px 25px;background:#607c6b;
 color:white;font:700 15px Tajawal;cursor:pointer;transition:.25s
}
button:hover{background:#b79b68;color:#263d34;transform:translateY(-2px)}
button:disabled{opacity:.65;cursor:default;transform:none}

/* الأقسام */
.section{width:90%;max-width:1250px;margin:75px auto}
.section-head{
 display:flex;align-items:center;justify-content:space-between;gap:15px;
 padding:17px 22px;margin-bottom:30px;border:1px solid #e4e0d5;
 border-right:0;border-radius:16px 4px 16px 4px;background:linear-gradient(105deg,#fff 0%,#f3f4ee 100%);
 box-shadow:0 8px 22px #26352c0a;position:relative
}
.section-head:before{content:"";position:absolute;right:0;top:15%;height:70%;width:5px;background:#b79b68;border-radius:5px}
.section-head h2{font-size:clamp(25px,3vw,35px);color:#536d60;margin:0}
.section-head p{color:#928f82;margin:0;font-size:14px}

/* أبواب المجلة — توزيع تحريري غير متماثل */
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-flow:dense;gap:19px;align-items:stretch}
.card{
 background:#fff;overflow:hidden;position:relative;display:flex;flex-direction:column;
 box-shadow:0 10px 28px #26352c10;transition:transform .3s,box-shadow .3s;
 border-radius:22px;min-height:360px;border:1px solid #e7e5dc
}
.card:hover{transform:translateY(-7px);box-shadow:0 18px 38px #26352c1c}
.card img{width:100%;height:190px;object-fit:cover;display:block;transition:transform .55s}
.card:hover img{transform:scale(1.045)}
.card-body{padding:20px 21px 23px;display:flex;flex:1;flex-direction:column;align-items:flex-start}
.number{
 display:inline-block;font-size:12px;color:#fff;font-weight:800;letter-spacing:.5px;
 padding:6px 12px;background:#718b78;border-radius:7px 7px 7px 2px
}
.card h3{font-size:22px;color:#536d60;margin:13px 0 8px}
.card p{line-height:1.9;color:#77796f;min-height:55px;font-size:14px;flex:1}
.card button{margin-top:8px}
.card:nth-child(1){grid-column:span 2;min-height:420px;border-color:#d6dfd2}
.card:nth-child(1) img{height:245px}
.card:nth-child(1) .card-body{padding:23px 27px}
.card:nth-child(1) h3{font-size:27px}
.card:nth-child(2){grid-column:span 2;display:grid;grid-template-columns:.9fr 1.1fr;min-height:420px;background:#f4f0e7}
.card:nth-child(2) img{height:100%;min-height:420px;order:2}
.card:nth-child(2) .card-body{justify-content:center;padding:26px}
.card:nth-child(2) .number{background:#b49a6b}
.card:nth-child(3){background:#e9eee7;border-color:#dce5d9}
.card:nth-child(3) .card-body{background:#e9eee7}
.card:nth-child(4){background:#f4f0e7;border-color:#e8dfcd}
.card:nth-child(4) .number{background:#b49a6b}
.card:nth-child(5){grid-column:span 2;display:grid;grid-template-columns:1fr 1fr;min-height:300px}
.card:nth-child(5) img{height:100%;min-height:300px}
.card:nth-child(5) .card-body{justify-content:center;padding:25px}
.card:nth-child(6){grid-column:span 1;background:#edf1f3}
.card:nth-child(6) .number{background:#788b9b}
.card:nth-child(7){grid-column:span 1;background:#f0eaf0}
.card:nth-child(7) .number{background:#9a7d96}

/* موضوع الدماغ */
.feature{
 display:grid;grid-template-columns:.9fr 1.1fr;gap:35px;align-items:center;
 background:#fff;padding:28px;border-radius:18px;border:1px solid #e6e4da;
 box-shadow:0 10px 30px #26352c0c
}
.feature img{width:100%;height:370px;object-fit:cover;border-radius:13px}
.feature-copy{
 position:relative;background:linear-gradient(145deg,#f3f5ef,#e9eee7);
 border:1px solid #d9e2d6;border-right:6px solid #718b78;
 border-radius:16px;padding:28px;box-shadow:inset 0 0 25px #718b780c
}
.feature-copy:before{
 content:"معلومة تستحق المعرفة";display:inline-block;background:#fff;
 color:#718b78;border:1px solid #dce5d8;border-radius:30px;
 padding:7px 14px;font-size:13px;font-weight:800;margin-bottom:12px
}
.feature-copy h2{font-size:34px;color:#536d60;margin:8px 0 18px;line-height:1.5}
.feature-copy p{line-height:2.1;color:#626e63;font-size:16px;margin:12px 0}
.feature-copy button{margin-top:10px}

/* القارئ الصوتي */
.audio-reader{
 background:#fff;border:1px solid #e5e5dc;border-radius:16px;
 padding:30px;margin:25px 0;box-shadow:0 8px 25px #26352c0b;position:relative
}
.audio-reader:before{
 content:"مساحة استماع";display:inline-block;color:#758b78;font-size:13px;
 font-weight:800;margin-bottom:12px;padding:6px 12px;border:1px solid #dce3d9;border-radius:20px
}
.audio-reader h2{margin:0 0 18px;color:#536d60;font-size:27px}
.audio-reader p{line-height:2;color:#756f68}
.audio-controls{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.audio-controls button{border-radius:9px}
.audio-controls .stop{background:#edf0e9;color:#536d60}
.reader-status{font-size:14px;color:#8b8e7e;margin-top:15px}
.reader-text{
 background:#f5f5ef;padding:22px;border-radius:12px;line-height:2.2;
 color:#5e665d;border-right:4px solid #b79b68;font-size:17px;margin-top:15px
}
.show-text-btn{background:#edf1e9;color:#536d60;border:1px solid #dce3d9;margin-bottom:10px}
.show-text-btn:hover{background:#536d60;color:white}
.speed-control{
 display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:20px;
 padding:14px 16px;background:#f4f6f1;border:1px solid #e1e7dc;border-radius:11px
}
.speed-control label{color:#536d60;font-weight:800;font-size:14px}
.speed-control select{
 min-width:150px;padding:10px 14px;border:1px solid #d5dfd2;
 border-radius:8px;background:#fff;color:#536d60;font:700 14px Tajawal;outline:none;cursor:pointer
}
.speed-control select:focus{border-color:#718b78;box-shadow:0 0 0 3px #718b7820}

/* المساعد الذكي */
.assistant-box{
 background:#fff;border-radius:16px;padding:32px;border:1px solid #e5e5dc;
 box-shadow:0 8px 25px #26352c0b
}
.assistant-box h2{color:#536d60;margin-top:0}
.assistant-box>p{line-height:2;color:#716f65}
.assistant-questions{display:flex;flex-wrap:wrap;gap:10px;margin:18px 0}
.assistant-questions button{background:#f2f4ee;color:#536d60;border:1px solid #dfe5da;padding:10px 16px}
.assistant-questions button:hover{background:#536d60;color:#fff}
.assistant-response{
 background:#f5f6f1;border-radius:12px;padding:20px;line-height:2;
 min-height:90px;color:#5e665d;margin-top:15px;border-right:4px solid #78917b
}
.assistant-response strong{color:#536d60}
.assistant-disclaimer{font-size:13px;color:#8b8e7e;margin-top:12px}
.assistant-input{
 width:100%;padding:13px;border:1px solid #dfe2d8;border-radius:9px;
 font:inherit;margin:10px 0
}

/* الفيديو */
.video-box{background:#30463b;padding:30px;border-radius:17px;color:white;box-shadow:0 12px 30px #26352c20}
.video-box iframe{width:100%;height:390px;border:0;border-radius:12px;display:block;background:#182b23}
.video-box h3{color:#e6d2a9;font-size:24px}

/* الاختبار */
.quiz{background:#edf0e9;border-radius:15px;padding:28px;border:1px solid #dfe4d9}
.quiz label{display:block;margin:14px 0}
.quiz input[type=radio]{accent-color:#607c6b}
.answer{font-weight:700;line-height:1.8}
.quiz-progress{height:10px;background:#dce3d8;border-radius:20px;margin:15px 0 25px;overflow:hidden}
.quiz-progress div{height:100%;width:0;background:#718b78;border-radius:20px;transition:.3s}
.answer-option{
 display:block;width:100%;margin:10px 0;text-align:right;border-radius:9px;
 background:#fff;color:#536257;border:1px solid #dfe5da
}
.answer-option:hover{background:#e2eade}
.answer-option.correct{background:#568b70;color:#fff}
.answer-option.wrong{background:#b66c79;color:#fff}
.quiz-meta{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
.result-card{background:#fff;border-radius:12px;padding:20px;margin-top:20px}
.result-card h3{color:#536d60}
#quizAnswers{margin-top:15px}

/* ألعاب الذاكرة */
.games-intro{line-height:2;color:#697268;font-size:16px;margin-bottom:25px}
.memory-game{
 background:#fff;border:1px solid #e0e5dc;border-radius:16px;
 padding:25px;margin:25px 0;box-shadow:0 6px 20px #26352c0a
}
.memory-game h2{color:#536d60;margin-top:0;font-size:25px}
.game-tag{
 display:inline-block;padding:6px 13px;border-radius:20px;
 background:#edf1e9;color:#718b78;font-size:13px;font-weight:800;margin-bottom:12px
}
.game-instruction{color:#77796f;line-height:1.9;margin:8px 0 18px}
.game-display{
 min-height:105px;display:flex;justify-content:center;align-items:center;
 flex-wrap:wrap;gap:12px;background:#f1f4ed;border:1px dashed #cbd8c8;
 border-radius:13px;padding:20px;margin:15px 0;text-align:center
}
.game-display strong{color:#536d60;font-size:32px;letter-spacing:5px}
.game-input{
 width:100%;padding:14px;border:1px solid #d7dfd3;border-radius:9px;
 font:16px Tajawal;margin:12px 0;outline:none
}
.game-input:focus{border-color:#718b78;box-shadow:0 0 0 3px #718b7818}
.game-result{
 background:#f5f6f1;border-right:4px solid #b79b68;padding:15px;
 border-radius:9px;line-height:2;margin-top:15px;color:#536257;min-height:25px
}
.game-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}
.game-secondary{background:#edf0e9;color:#536d60}
.game-secondary:hover{background:#536d60;color:#fff}
.picture-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;width:100%}
.picture-tile{
 background:#fff;border:1px solid #dfe5da;border-radius:12px;
 padding:13px 8px;text-align:center;color:#536d60;min-height:105px;
 display:flex;flex-direction:column;justify-content:center;align-items:center;gap:6px
}
.picture-tile .picture-emoji{font-size:37px;line-height:1.4}
.picture-tile span:last-child{font-size:13px;font-weight:700}
.game-score{color:#718b78;font-weight:800;margin-top:12px}

/* مفكرة العقل */
.journal-intro{
 background:#f1f4ed;border-right:4px solid #718b78;padding:18px;
 border-radius:10px;line-height:2;color:#626e63;margin:20px 0
}
.journal-card{
 background:#fff;border:1px solid #e0e5dc;border-radius:14px;
 padding:22px;margin:20px 0
}
.journal-card h2{color:#536d60;margin-top:0}
.journal-card p{color:#77796f;line-height:1.8}
.journal-card textarea{
 width:100%;min-height:105px;padding:14px;border:1px solid #d7dfd3;
 border-radius:10px;font:16px Tajawal;resize:vertical;outline:none;margin:8px 0 12px
}
.journal-card textarea:focus{border-color:#718b78;box-shadow:0 0 0 3px #718b7818}
.journal-saved{
 background:#f5f6f1;border-radius:12px;padding:17px;margin-top:15px;
 border-right:4px solid #b79b68;line-height:2;overflow-wrap:anywhere
}
.journal-saved h3{color:#536d60;margin:0 0 8px}
.journal-saved small{color:#8b8e7e}
.journal-entry{background:#fff;border:1px solid #e1e5dc;border-radius:10px;padding:15px;margin:12px 0}
.journal-entry p{white-space:pre-wrap;line-height:2;color:#5e665d}
.journal-entry button{padding:8px 14px;font-size:13px;background:#eee9e5;color:#805e56}
.journal-entry button:hover{background:#805e56;color:#fff}
.empty-journal{color:#898d80;background:#f5f6f1;padding:18px;border-radius:10px;line-height:2}

/* رحلتي مع الذاكرة */
.progress-intro{
 background:#f1f4ed;border-right:4px solid #718b78;padding:18px;
 border-radius:10px;line-height:2;color:#626e63;margin-bottom:22px
}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:20px 0}
.stat-card{
 background:#fff;border:1px solid #e0e5dc;border-radius:13px;
 padding:20px 12px;text-align:center
}
.stat-card strong{display:block;font-size:30px;color:#536d60;margin-bottom:5px}
.stat-card span{font-size:13px;color:#858879}
.badges-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:20px}
.badge-card{
 background:#fff;border:1px solid #e0e5dc;border-radius:12px;
 padding:18px;display:flex;align-items:center;gap:14px
}
.badge-card .badge-symbol{
 width:48px;height:48px;border-radius:50%;display:flex;
 align-items:center;justify-content:center;background:#edf1e9;
 color:#718b78;font-size:22px;flex-shrink:0
}
.badge-card h3{margin:0 0 5px;color:#536d60;font-size:17px}
.badge-card p{margin:0;color:#8b8e7e;font-size:13px;line-height:1.7}
.badge-card.locked{opacity:.55;filter:grayscale(1)}
.progress-line{height:10px;background:#e3e8df;border-radius:20px;overflow:hidden;margin:12px 0}
.progress-line div{height:100%;background:#718b78;width:0;transition:.3s}

/* صفحات القراءة */
#reader{display:none}
.paper{
 background:#fff;border-radius:16px;padding:40px;
 box-shadow:0 8px 30px #26352c12;border:1px solid #e8e7df
}
.paper h1,.paper h2{color:#536d60}
.paper h1{font-size:36px}
.paper p{font-size:17px;line-height:2.1;color:#625f57}
.paper img{width:100%;max-height:370px;object-fit:cover;border-radius:13px;margin:15px 0}
.note{background:#f1f4ed;border-right:4px solid #78917b;padding:18px 20px;border-radius:10px;line-height:2;margin:20px 0}
.paper input{width:100%;padding:13px;border:1px solid #dfe2d8;border-radius:10px;font:inherit;margin:10px 0}
.back{background:#e9eee7;color:#536d60;margin-bottom:18px}

/* التذييل */
footer{
 background:#30463b;color:white;text-align:center;padding:45px 20px;
 margin-top:80px;border-top:5px solid #b79b68
}
footer h2{color:#e6d2a9}
footer p{color:#e3e8df;line-height:1.8}

/* الشاشات الصغيرة */
@media(max-width:900px){
 .grid{grid-template-columns:repeat(2,minmax(0,1fr))}
 .feature{grid-template-columns:1fr}
 .card:nth-child(1),.card:nth-child(2),.card:nth-child(5){grid-column:span 2}
 .card:nth-child(2){grid-template-columns:1fr 1fr}
 .card:nth-child(2) img{height:100%;min-height:350px}
 .card:nth-child(5){grid-template-columns:1fr 1fr}
 .stats-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:600px){
 header{padding:12px 4%}
 .college-logo{width:100px;height:45px}
 .logo{font-size:18px}
 .logo span{font-size:10px}
 nav{gap:6px}
 nav a{font-size:12px;padding:7px 9px}
 .hero{height:420px;border-radius:16px}
 .hero-content{right:6%;left:6%}
 .hero h1{font-size:37px}
 .hero p{font-size:15px}
 .section{width:92%;margin:55px auto}
 .section-head{display:block;padding:14px}
 .section-head p{margin-top:8px}
 .grid{grid-template-columns:1fr;grid-auto-rows:auto}
 .card,.card:nth-child(1),.card:nth-child(2),.card:nth-child(5),.card:nth-child(6),.card:nth-child(7){grid-column:auto;grid-row:auto;display:flex;flex-direction:column;min-height:0}
 .card:nth-child(1) img,.card:nth-child(2) img,.card:nth-child(5) img,.card img{height:220px;min-height:220px;order:0}
 .card:nth-child(1) h3{font-size:24px}
 .feature{padding:20px;gap:20px}
 .feature img{height:250px}
 .feature-copy{padding:20px}
 .feature-copy h2{font-size:27px}
 .feature-copy p{font-size:15px}
 .paper{padding:20px}
 .paper h1{font-size:29px}
 .audio-reader{padding:20px}
 .audio-controls button{flex:1}
 .speed-control{align-items:stretch;flex-direction:column}
 .speed-control select{width:100%}
 .video-box{padding:15px}
 .video-box iframe{height:230px}
 .assistant-box{padding:20px}
 .memory-game{padding:17px}
 .picture-grid{grid-template-columns:repeat(2,1fr)}
 .stats-grid{grid-template-columns:repeat(2,1fr)}
 .badges-grid{grid-template-columns:1fr}
}
</style>
</head>

<body>

<header>
 <div class="header-brand">
  <img class="college-logo" src="https://cdn.brandfetch.io/idWUP5nC56/theme/dark/logo.svg?c=1bxid64Mup7aczewSAYMX&t=1790030663156" alt="شعار المؤسسة العامة للتدريب التقني والمهني">
  <div class="logo">تنمية الذاكرة<span>مجلة المعرفة والاكتشاف</span></div>
 </div>
 <nav>
  <a onclick="showHome()">الرئيسية</a>
  <a onclick="goToSection('sections')">أبواب المجلة</a>
  <a onclick="goToSection('audio')">القارئ الصوتي</a>
  <a onclick="goToSection('assistant')">مساعد التعلم</a>
  <a onclick="goToSection('video')">الفيديو</a>
  <a onclick="goToSection('test')">اختبري نفسك</a>
 </nav>
</header>

<main id="home">

<section class="hero">
<img src="https://upscend-aiblog-dev.s3.eu-central-1.amazonaws.com/content-images/how-can-neuroscience-motivation-learning-improve-completion.webp" alt="دماغ هولوغرافي مضيء">
<div class="hero-content">
<div class="eyebrow">العدد الأول · اكتشفي عالم عقلك</div>
<h1>ذاكرتك.. عالم يستحق الاكتشاف</h1>
<p>رحلة بين أسرار الدماغ وطرق الحفظ والتركيز. اقرئي، جرّبي، واكتشفي كيف تعمل ذاكرتك.</p>
<button onclick="goToSection('sections')">ابدئي الرحلة</button>
</div>
</section>

<section class="section" id="sections">
<div class="section-head">
<h2>أبواب المجلة</h2>
<p>سبعة أبواب معرفية، في كل باب اكتشاف جديد</p>
</div>

<div class="grid">

<div class="card">
<img src="https://www.infobae.com/resizer/v2/GE3GB3BA4VBW7GRI26JE5PKII4.jpg?auth=048f525d926a5c9a9b824dc418fb1d39d7bbe742621464029ada69b904620a9b&height=900&quality=85&smart=true&width=1200" alt="الدماغ والذاكرة">
<div class="card-body">
