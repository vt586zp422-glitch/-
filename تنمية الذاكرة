 forget:["انسى","انسي","نسيان","النسيان","نسيت","ليش انسى","لماذا انسى","انسى المعلومات"],
 study:["احفظ","الحفظ","مذاكره","اذاكر","اذكر","استذكر","كيف احفظ","طرق الحفظ"],
 focus:["تركيز","التركيز","اركيز","ركز","اتشتت","تشتت","مشتتات","انتباه","انتبه"],
 review:["مراجعه","المراجعه","اراجع","راجع","كيف اراجع","المراجعة"],
 sleep:["نوم","النوم","اسهر","السهر","انام","النوم والذاكره"]
};

function detectAssistantTopic(question){
 const q=normalizeArabic(question);
 const tests=[
  ["forget",assistantKeywords.forget],
  ["study",assistantKeywords.study],
  ["focus",assistantKeywords.focus],
  ["review",assistantKeywords.review],
  ["sleep",assistantKeywords.sleep],
  ["memory",assistantKeywords.memory]
 ];
 for(const [topic,words] of tests){
  if(words.some(word=>q.includes(normalizeArabic(word))))return topic;
 }
 return null;
}

function askAssistant(topic){
