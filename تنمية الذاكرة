/* اللعبة الثالثة: اكتشاف الصورة الناقصة */
const pictureItems=[
 {emoji:"🍎",name:"تفاحة"},
 {emoji:"🚗",name:"سيارة"},
 {emoji:"🌸",name:"زهرة"},
 {emoji:"⭐",name:"نجمة"},
 {emoji:"🐠",name:"سمكة"},
 {emoji:"📚",name:"كتب"}
];

let missingPicture=null;
let pictureTimer=null;
let pictureAnswered=false;

function renderPictureTiles(items){
 const container=document.getElementById("pictureDisplay");
 container.innerHTML='<div class="picture-grid">'+items.map(function(item){
  return '<div class="picture-tile"><span class="picture-emoji">'+item.emoji+'</span><span>'+item.name+'</span></div>';
 }).join("")+'</div>';
}

function startPictureGame(){
 clearTimeout(pictureTimer);
 pictureAnswered=false;
 const choices=document.getElementById("pictureAnswerArea");
 const result=document.getElementById("pictureResult");
 const startButton=document.getElementById("startPictureBtn");
 const input=document.getElementById("missingPictureInput");

 choices.style.display="none";
 input.value="";
 result.textContent="احفظي الصور الست جيدًا...";
 document.getElementById("pictureScore").textContent="";
 startButton.disabled=true;

 missingPicture=pictureItems[Math.floor(Math.random()*pictureItems.length)];
 renderPictureTiles(pictureItems);

 pictureTimer=setTimeout(function(){
  /* تختفي جميع الصور ولا نعيد عرض أي صورة بعد ذلك */
  document.getElementById("pictureDisplay").innerHTML=
   '<div style="color:#718b78;font-weight:800;font-size:20px;padding:20px">اختفت الصور! حاولي تذكّر الصورة الناقصة.</div>';

  choices.style.display="block";
  startButton.disabled=false;
  result.textContent="اكتبي اسم الصورة التي اختفت من المجموعة.";
  input.focus();
 },5000);
}

function checkMissingPicture(){
 if(pictureAnswered)return;
 const input=document.getElementById("missingPictureInput");
 const answer=normalizeArabic(input.value);
 const result=document.getElementById("pictureResult");

 if(!answer){
  result.textContent="اكتبي اسم الصورة التي تتذكرين أنها اختفت أولًا.";
  return;
 }

 pictureAnswered=true;
 const correct=normalizeArabic(missingPicture.name);
 const isCorrect=answer===correct||answer.includes(correct)||correct.includes(answer);

 if(isCorrect){
  result.textContent="أحسنتِ! إجابة صحيحة. الصورة التي اختفت هي: "+missingPicture.name+".";
  document.getElementById("pictureScore").textContent="رائعة! نجحتِ في تحدي الذاكرة البصرية.";
 }else{
  result.textContent="محاولة جميلة! الصورة التي اختفت هي: "+missingPicture.name+". جربي مرة أخرى في جولة جديدة.";
  document.getElementById("pictureScore").textContent="كل محاولة تساعدك على تدريب الملاحظة والتذكر.";
 }

 input.disabled=true;
 document.getElementById("checkPictureBtn").disabled=true;
 recordGame();
}

/* مفكرة العقل */
function getJournalEntries(){
 try{
  return JSON.parse(localStorage.getItem("mindJournalEntries")||"[]");
 }catch(e){
  return [];
 }
}

function saveJournal(inputId,title){
 const input=document.getElementById(inputId);
 const text=input.value.trim();

 if(!text){
  alert("اكتبي ملاحظتك أولًا قبل الحفظ.");
  return;
 }

 const entries=getJournalEntries();
 entries.unshift({
  id:Date.now(),
  title:title,
  text:text,
  date:new Date().toLocaleDateString("ar-SA")
 });

 localStorage.setItem("mindJournalEntries",JSON.stringify(entries));
 input.value="";
 recordNote();
 loadJournal();
}

function loadJournal(){
 const container=document.getElementById("journalEntries");
 if(!container)return;

 const entries=getJournalEntries();

 if(entries.length===0){
  container.innerHTML='<div class="empty-journal">لم تحفظي أي ملاحظات بعد. ابدئي بكتابة أول فكرة في مفكرتك!</div>';
  return;
 }

 container.innerHTML=entries.map(function(entry){
  return '<div class="journal-entry">'+
   '<h3>'+escapeHTML(entry.title)+'</h3>'+
   '<small>'+escapeHTML(entry.date)+'</small>'+
   '<p>'+escapeHTML(entry.text)+'</p>'+
   '<button onclick="deleteJournalEntry('+entry.id+')">حذف الملاحظة</button>'+
   '</div>';
 }).join("");
}

function deleteJournalEntry(id){
 const entries=getJournalEntries().filter(function(entry){return entry.id!==id;});
 localStorage.setItem("mindJournalEntries",JSON.stringify(entries));
 loadJournal();
}

