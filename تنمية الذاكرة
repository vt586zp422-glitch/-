let questionIndex=0,quizScore=0,answered=false,userAnswers=[];

function startQuiz(){
 questionIndex=0;quizScore=0;answered=false;userAnswers=[];
 document.getElementById("scoreLive").textContent="النتيجة: 0";
 document.getElementById("finalResult").style.display="none";
 document.getElementById("restartButton").style.display="none";
 document.getElementById("nextButton").style.display="none";
 document.getElementById("feedback").textContent="";
 document.getElementById("progressBar").style.width="0%";
 document.getElementById("questionText").style.display="block";
 document.getElementById("quizAnswers").style.display="block";
 document.getElementById("questionNumber").style.display="block";
 document.getElementById("scoreLive").style.display="block";
 document.querySelector("#quizBox > .quiz-progress").style.display="block";
 showQuestion();
}

function showQuestion(){
 const q=quizQuestions[questionIndex];
 answered=false;
 document.getElementById("questionNumber").textContent="السؤال "+(questionIndex+1)+" من "+quizQuestions.length;
 document.getElementById("questionText").textContent=q.q;
 document.getElementById("feedback").textContent="";
 document.getElementById("nextButton").style.display="none";
 const box=document.getElementById("quizAnswers");
 box.innerHTML="";
 q.a.forEach(function(answer,index){
  const btn=document.createElement("button");
  btn.textContent=answer;btn.className="answer-option";
  btn.onclick=function(){chooseAnswer(index,btn)};
  box.appendChild(btn);
 });
}

function chooseAnswer(index,button){
 if(answered)return;
 answered=true;
 const q=quizQuestions[questionIndex];
 const buttons=document.querySelectorAll("#quizAnswers button");
 buttons.forEach(function(b){b.disabled=true;});
 userAnswers.push(index);
 if(index===q.correct){
  quizScore++;button.classList.add("correct");
  document.getElementById("feedback").textContent="إجابة صحيحة! "+q.explain;
 }else{
  button.classList.add("wrong");buttons[q.correct].classList.add("correct");
  document.getElementById("feedback").textContent="الإجابة الصحيحة: "+q.a[q.correct]+". "+q.explain;
 }
 document.getElementById("scoreLive").textContent="النتيجة: "+quizScore;
 document.getElementById("progressBar").style.width=((questionIndex+1)/quizQuestions.length*100)+"%";
 document.getElementById("nextButton").style.display="inline-block";
 document.getElementById("nextButton").textContent=questionIndex===quizQuestions.length-1?"عرض نتيجتي":"السؤال التالي";
}

function nextQuestion(){
 if(!answered)return;
 if(questionIndex<quizQuestions.length-1){
  questionIndex++;showQuestion();
 }else{
  showFinalResult();
 }
}

function showFinalResult(){
 document.getElementById("questionText").style.display="none";
 document.getElementById("quizAnswers").style.display="none";
 document.getElementById("questionNumber").style.display="none";
 document.getElementById("scoreLive").style.display="none";
 document.getElementById("nextButton").style.display="none";

 const percent=Math.round(quizScore/quizQuestions.length*100);
 document.getElementById("finalResult").style.display="block";
 document.getElementById("finalScore").textContent="نتيجتك: "+quizScore+" من "+quizQuestions.length;
 document.getElementById("finalBar").style.width=percent+"%";
 document.getElementById("resultPercent").textContent="نسبة الإجابات الصحيحة: "+percent+"%";

 let message=quizScore===5?"ممتاز! أتقنتِ جميع الأسئلة.":quizScore>=3?"أحسنتِ! لديك فهم جيد، واصلي التعلم.":"بداية جيدة! راجعي أبواب المجلة وحاولي مرة أخرى.";
 document.getElementById("finalMessage").textContent=message;

 let best=Number(localStorage.getItem("memoryBestScore")||0);
 if(quizScore>best){
  best=quizScore;
  localStorage.setItem("memoryBestScore",best);
 }
 document.getElementById("bestScore").textContent="أعلى درجة حققتِها: "+best+" من 5";

 let review="";
 quizQuestions.forEach(function(q,i){
  const correct=userAnswers[i]===q.correct;
  review+=`<div class="note"><b>${i+1}. ${q.q}</b><br>إجابتك: ${q.a[userAnswers[i]]}<br>${correct?"إجابة صحيحة":"الإجابة الصحيحة: "+q.a[q.correct]}</div>`;
 });
 document.getElementById("reviewAnswers").innerHTML=review;

 const weakTopics=[];
 quizQuestions.forEach(function(q,i){
  if(userAnswers[i]!==q.correct)weakTopics.push(q.topic);
 });

 const analysis=document.getElementById("smartQuizAnalysis");
 analysis.style.display="block";
 analysis.innerHTML="<strong>التحليل الذكي لنتيجتك</strong><br>"+
 (weakTopics.length
 ? "الموضوعات التي يُنصح بمراجعتها: <b>"+weakTopics.map(escapeHTML).join("، ")+"</b><br>التوصية: اقرئي الموضوعات المرتبطة بهذه المهارات في أبواب المجلة، ثم أعيدي الاختبار."
 : "رائع! أجبتِ عن جميع الأسئلة بشكل صحيح. استمري في تنمية مهاراتك من خلال التحديات والأنشطة.");

 localStorage.setItem("lastLearningAnalysis",JSON.stringify({
  score:quizScore,weakTopics:weakTopics,date:new Date().toLocaleDateString("ar-SA")
 }));

 recordQuiz();
 document.getElementById("restartButton").style.display="inline-block";
}

function restartQuiz(){startQuiz();}

/* اللعبة الأولى: تذكّر الأرقام */
let secret="";
let numberTimer=null;

function showNumber(){
 clearTimeout(numberTimer);
 const numberElement=document.getElementById("number");
 const input=document.getElementById("numberInput");
 const checkButton=document.getElementById("checkNumberBtn");
 const startButton=document.getElementById("showNumberBtn");
 const result=document.getElementById("numberResult");

 secret=String(Math.floor(10000+Math.random()*90000));
 numberElement.textContent=secret;
 input.value="";input.disabled=true;checkButton.disabled=true;startButton.disabled=true;
 result.textContent="احفظي الرقم جيدًا...";

 numberTimer=setTimeout(function(){
  numberElement.textContent="اختفى الرقم! اكتبيه الآن.";
  input.disabled=false;checkButton.disabled=false;startButton.disabled=false;
  input.focus();result.textContent="انتهى وقت الحفظ. اكتبي الرقم الذي شاهدتِه.";
 },3000);
}

function checkNumber(){
 const value=document.getElementById("numberInput").value.trim();
 const result=document.getElementById("numberResult");
 if(!value){result.textContent="اكتبي الرقم أولًا.";return;}
 if(value===secret){
  result.textContent="ممتاز! إجابة صحيحة، تذكرتِ الرقم كاملًا.";
 }else{
  result.textContent="لم تكن الإجابة مطابقة. الرقم الصحيح هو: "+secret+". حاولي مرة أخرى!";
 }
 document.getElementById("checkNumberBtn").disabled=true;
 recordGame();
}

